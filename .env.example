# Copy to `.env` and fill in the keys for the stack(s) you intend to run.
# Each stack reads only the variables it needs — leaving the rest blank is fine.

# --- OpenAI (used by: simple, postgres, advanced stacks) ---
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Anthropic (optional alternative Generator) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Cohere (used by: advanced stack reranker) ---
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-english-v3.0

# --- Snowflake / Cortex (used by: cortex stack) ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_CORTEX_SEARCH_SERVICE=
SNOWFLAKE_CORTEX_CHAT_MODEL=mistral-large2
SNOWFLAKE_CORTEX_EMBEDDING_MODEL=e5-base-v2

# --- Postgres / pgvector (used by: postgres stack — conversation, prompt, vector store) ---
POSTGRES_URL=postgresql://user:password@localhost:5432/rag

# --- Chroma (used by: simple stack VectorStore) ---
CHROMA_PERSIST_DIR=./.chroma

# --- SQLite (used by: simple stack ConversationStore + PromptStore) ---
SQLITE_PATH=./rag.db
